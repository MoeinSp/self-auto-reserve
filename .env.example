# Copy to .env and fill in.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Friends need this code to sign up (the first user doesn't).
INVITE_CODE=
# Optional: this panel user is created/updated as an admin on every start.
# (Otherwise the first user who signs up is the admin.)
ADMIN_USERNAME=
ADMIN_PASSWORD=

SITE_URL=https://nut.uk.ac.ir/
BASKET_PATH=FoodBasket/FoodBasketBuy.aspx

# Rate limiting — keep these conservative so the account isn't blocked.
# These are defaults; an admin can change them live in the panel (/admin).
POLL_SECONDS=20
STEP_SECONDS=1.5
POLL_JITTER=0.4
MAX_REQUESTS_PER_HOUR=500
MAX_LOGINS_PER_HOUR=6

CAPTCHA_OCR_TRIES=3
